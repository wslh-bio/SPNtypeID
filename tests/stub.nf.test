nextflow_pipeline {

    name "Stub test of main.nf"
    script "../main.nf"
    tag "pipeline"
    tag "stub"

    test("-stub-run") {

        options "-stub-run"

        when {
            params {
                outdir = "$outputDir"
                input = "$baseDir" + "/samplesheets/workflow_test.csv"
                runname = "test"
                ntc_regex = "NTC"
            }
        }

        then {
            assert workflow.success
        }
    }
}
