nextflow_pipeline {

    name "Test Workflow main.nf"
    script "../main.nf"
    tag "pipeline"

    test("-profile test_full") {

        when {
            params {
                outdir = "$outputDir"
                input = "$baseDir" + "/samplesheets/workflow_test.csv"
                runname = "test"
                ntc_regex = "NTC"
            }
        }

        then {

            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(
                                                params.outdir,
                                                relative: true,
                                                includeDir: true,
                                                ignore: ['pipeline_info/*.{html,json,txt}']
                                                )

            def per_strep = "${params.outdir}/percent_strep_summary/percent_strep_results.tsv"

            if (per_strep.contains("/dev-wslh") || per_strep.contains("/prod-wslh")) {

                // Setting up variables
                def to_download_s3_per_strep    = "s3:/" + "${params.outdir}/percent_strep_summary/percent_strep_results.tsv"
                def to_download_s3_report       = "s3:/" + "${params.outdir}/report_with_ntc/test_spntypeid_report.csv"
                def to_download_s3_assembly     = "s3:/" + "${params.outdir}/assembly_stats_summary/assembly_stats_results_summary.tsv"
                def to_download_s3_quality      = "s3:/" + "${params.outdir}/quality_stats/quality_stats.tsv"
                def to_download_s3_quast        = "s3:/" + "${params.outdir}/quast_summary/quast_results.tsv"
                def to_download_s3_seroba       = "s3:/" + "${params.outdir}/seroba_summary/seroba_results.tsv"

                // Downloading files from S3
                def s3_per_strep    = downloadFromS3( to_download_s3_per_strep  )
                def s3_report       = downloadFromS3( to_download_s3_report     )
                def s3_assembly     = downloadFromS3( to_download_s3_assembly   )
                def s3_quality      = downloadFromS3( to_download_s3_quality    )
                def s3_quast        = downloadFromS3( to_download_s3_quast      )
                def s3_seroba       = downloadFromS3( to_download_s3_seroba     )

                assertAll(
                    { assert workflow.success                                                       },
                    { assert s3_per_strep.exists()                                                  },
                    { assert s3_report.exists()                                                     },
                    { assert s3_assembly.exists()                                                   },
                    { assert s3_quality.exists()                                                    },
                    { assert s3_quast.exists()                                                      },
                    { assert s3_seroba.exists()                                                     },
                    { assert s3_seroba.contains("SPN_Sample_02")                                    },
                    { assert s3_quast.contains("Assembly Length (bp)")                              },
                    { assert s3_quality.contains("SPN_Sample_03")                                   },
                    { assert s3_assembly.contains("Ratio of Actual:Expected Genome Length")         },
                    { assert s3_report.contains("SPN_Sample_01,test_full")                          },
                    { assert s3_per_strep.contains("More than 1.0% of reads are from Escherichia")  },
                    { assert snapshot(
                            workflow.trace.succeeded().size(),
                            removeNextflowVersion("$outputDir/pipeline_info/software_versions.yml"),
                            // All stable path name, with a relative path
                            stable_name
                        ).match()
                    }
                )
            } else {
                assertAll(
                    { assert workflow.success},
                    { assert file("${params.outdir}/percent_strep_summary/percent_strep_results.tsv").exists()                                                      },
                    { assert file("${params.outdir}/report_with_ntc/test_spntypeid_report.csv").exists()                                                            },
                    { assert file("${params.outdir}/assembly_stats_summary/assembly_stats_results_summary.tsv").exists()                                            },
                    { assert file("${params.outdir}/quality_stats/quality_stats.tsv").exists()                                                                      },
                    { assert file("${params.outdir}/quast_summary/quast_results.tsv").exists()                                                                      },
                    { assert file("${params.outdir}/seroba_summary/seroba_results.tsv").exists()                                                                    },
                    { assert file("${params.outdir}/seroba_summary/seroba_results.tsv").contains("SPN_Sample_02")                                                   },
                    { assert file("${params.outdir}/quast_summary/quast_results.tsv").contains("Assembly Length (bp)")                                              },
                    { assert file("${params.outdir}/quality_stats/quality_stats.tsv").contains("SPN_Sample_03")                                                     },
                    { assert file("${params.outdir}/assembly_stats_summary/assembly_stats_results_summary.tsv").contains("Ratio of Actual:Expected Genome Length")  },
                    { assert file("${params.outdir}/report_with_ntc/test_spntypeid_report.csv").contains("SPN_Sample_01,test_full")                                 },
                    { assert file("${params.outdir}/percent_strep_summary/percent_strep_results.tsv").contains("More than 1.0% of reads are from Escherichia")      },
                    { assert snapshot(
                            workflow.trace.succeeded().size(),
                            removeNextflowVersion("$outputDir/pipeline_info/software_versions.yml"),
                            // All stable path name, with a relative path
                            stable_name
                        ).match()
                    }
                )
            }
        }
    }
}

