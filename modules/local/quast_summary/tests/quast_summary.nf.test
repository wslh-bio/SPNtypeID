nextflow_process {

    name "Test Process QUAST_SUMMARY"
    script "modules/local/quast_summary/quast_summary.nf"
    process "QUAST_SUMMARY"
    tag "module"

    test("Checking mandatory output produces appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/quast_summary/tests"
                """
                input[0] = [
                file("${data_dir}" + "/data1/SPN_Sample_01.transposed.quast.report.tsv"),
                file("${data_dir}" + "/data2/SPN_Sample_02.transposed.quast.report.tsv"),
                file("${data_dir}" + "/data3/SPN_Sample_03.transposed.quast.report.tsv")
                ]
                input[1] = "300"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.exitStatus == 0 },
                { assert process.out.quast_tsv.size() == 1 }
            )
        }
    }

    test("Checking file contents to ensure proper processing") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/quast_summary/tests"
                """
                input[0] = [
                file("${data_dir}" + "/data1/SPN_Sample_01.transposed.quast.report.tsv"),
                file("${data_dir}" + "/data2/SPN_Sample_02.transposed.quast.report.tsv"),
                file("${data_dir}" + "/data3/SPN_Sample_03.transposed.quast.report.tsv")
                ]
                input[1] = "300"
                """
            }
        }

        then {
            def outFile = process.out.quast_tsv[0]

            if (outFile.toString().contains("/dev-wslh") || outFile.toString().contains("/prod-wslh")) {

                def combined = "s3:/" + outFile.toString()
                def localFile = downloadFromS3(combined)

                assertAll(
                    { assert localFile.toString().split("/")[-1] ==~ "quast_results.tsv" },
                    { assert localFile.text.contains("Sample\tAssembly Length (bp)\tContigs\tN50\tPass Contigs\tQUAST Summary Comments")},
                    { assert localFile.text.contains("SPN_Sample_02")}

                )
            } else {
                assertAll(
                    { assert snapshot(path(outFile).md5).match() },
                    { assert file(outFile).name ==~ "quast_results.tsv" },
                    { assert file(outFile).text.contains("Sample\tAssembly Length (bp)\tContigs\tN50\tPass Contigs\tQUAST Summary Comments")},
                    { assert file(outFile).text.contains("SPN_Sample_02")}
                )
            }
        }
    }

    test("Checking that no input files channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                input[1] = "300"
                """
            }
        }

        then {
            assert !process.success
        }
    }

    test("Checking that no maxcontigs channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/quast_summary/tests"
                """
                input[0] =  [
                file("${data_dir}" + "/data1/SPN_Sample_01.transposed.quast.report.tsv"),
                file("${data_dir}" + "/data2/SPN_Sample_02.transposed.quast.report.tsv"),
                file("${data_dir}" + "/data3/SPN_Sample_03.transposed.quast.report.tsv")
                ]
                input[1] = null
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
