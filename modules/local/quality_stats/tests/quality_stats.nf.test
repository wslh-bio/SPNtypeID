nextflow_process {

    name "Test Process QUALITY_STATS"
    script "modules/local/quality_stats/quality_stats.nf"
    process "QUALITY_STATS"
    tag "module"

    test("Checking that output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/quality_stats/tests/"
                """
                input[0] = [
                file("${data_dir}" + "data1/SPN_Sample_01.qual.tsv"),
                file("${data_dir}" + "data2/SPN_Sample_02.qual.tsv"),
                file("${data_dir}" + "data3/SPN_Sample_03.qual.tsv")
                ]
                input[1] = "30"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.exitStatus == 0 },
                { assert process.out.quality_tsv.size() == 1 }
            )
        }
    }

   test("Checking file contents to ensure proper processing") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/quality_stats/tests/"
                """
                input[0] = [
                file("${data_dir}" + "data1/SPN_Sample_01.qual.tsv"),
                file("${data_dir}" + "data2/SPN_Sample_02.qual.tsv"),
                file("${data_dir}" + "data3/SPN_Sample_03.qual.tsv")
                ]
                input[1] = "30"
                """
            }
        }

        then {

            def outFile = process.out.quality_tsv[0]

            if (outFile.toString().contains("/dev-wslh") || outFile.toString().contains("/prod-wslh")) {

                def combined = "s3:/" + outFile.toString()
                def localFile = downloadFromS3(combined)

                assertAll(
                    { assert localFile.toString().endsWith("tsv")                        },
                    { assert localFile.text.contains("Sample	Median Read Quality")       },
                    { assert localFile.toString().split("/")[-1] ==~ "quality_stats.tsv" }
                )
            } else {
                assertAll(
                    { assert snapshot(path(outFile).md5).match()        },
                    { assert file(outFile).name.endsWith("tsv")         },
                    { assert file(outFile).name ==~ "quality_stats.tsv" }
                )
            }
        }
    }

    test("Checking that no input files channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/quality_stats/tests/"
                """
                input[0] = null
                input[1] = "30"
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
