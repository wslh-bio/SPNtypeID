nextflow_process {

    name "Test Process SHOVILL"
    script "modules/local/shovill/shovill.nf"
    process "SHOVILL"
    tag "module"

    test("Checking that mandatory output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.exitStatus == 0 },
                { assert process.out.contigs.size() == 1 },
                { assert process.out.sam_files.size() == 1 },
                { assert process.out.corrections.size() == 1 },
                { assert process.out.log.size() == 1 },
                { assert process.out.raw_contigs.size() == 1 },
                { assert process.out.versions.size() == 1 }
            )
        }
    }

    test("Checking that optional output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assert process.out.gfa.size() == 1
        }
    }

    test("Checking that output channels have appropriate contents") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            def output_dir_shovill = "$outputDir/shovill/test_shovill_output"
            assertAll(
                { assert file(process.out.versions[0]).name.endsWith("yml") },
                { assert file(process.out.contigs[0][1]).name.endsWith("fa") },
                { assert file(process.out.sam_files[0][1]).name.endsWith("sam") },
                { assert file(process.out.corrections[0][1]).name.endsWith("corrections") },
                { assert file(process.out.log[0][1]).name.endsWith("log") },
                { assert snapshot(
                    path(process.out.versions[0]).md5,
                    path("$output_dir_shovill/contigs.gfa").md5,
                    path("$output_dir_shovill/contigs.gfa").md5,
                    path("$output_dir_shovill/spades.fasta").md5
                    ).match()
                }
            )
        }
    }

    test("Checking that no input files channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
