nextflow_process {

    name "Test Process QUAST"
    script "modules/local/quast/quast.nf"
    process "QUAST"
    tag "module"

    test("Checking that output channels have appropriate amount of values") {

        when {
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/modules/local/quast/tests/SPN_Sample_01.contigs.fa') ]
                ]
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert process.out.transposed_report.size() == 1 },
                { assert file(process.out.transposed_report[0][1]).name.endsWith("tsv") },
                { assert process.out.result.size() == 1 },
                { assert file(process.out.result[0]).name.endsWith("tsv") },
                { assert process.out.versions.size() == 1 },
                { assert file(process.out.versions[0]).name.endsWith("yml") }



            )
        }
    }

    test("Checking file contents to ensure proper processing.") {
        when {
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/modules/local/quast/tests/SPN_Sample_01.contigs.fa') ]
                ]
                """
            }
        }

        then {
            assertAll (
                { assert snapshot(
                    path(process.out.transposed_report[0][1]).md5,
                    path(process.out.result[0]).md5
                    ).match()
                }
            )
        }
    }

    test("Checking that no input files channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                input[1] = []
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
