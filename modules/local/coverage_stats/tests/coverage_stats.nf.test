nextflow_process {

    name "Test Process COVERAGE_STATS"
    script "modules/local/coverage_stats/coverage_stats.nf"
    process "COVERAGE_STATS"
    tag "module"

    test("Checking that output channels have proper amounts of files") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${projectDir}/modules/local/coverage_stats/tests"
                """
                input[0] = [
                file("${data_dir}" + "/data1/SPN_Sample_01.depth.tsv"),
                file("${data_dir}" + "/data2/SPN_Sample_02.depth.tsv")
                ]
                input[1] = "40"
                """
            }
        }

        then {
            assertAll(
                { assert process.success                        },
                { assert process.exitStatus == 0                },
                { assert process.out.coverage_tsv.size() == 1   }
            )
        }
    }

    test("Checking file contents to ensure proper processing.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${projectDir}/modules/local/coverage_stats/tests"
                """
                input[0] = [
                file("${data_dir}" + "/data1/SPN_Sample_01.depth.tsv"),
                file("${data_dir}" + "/data2/SPN_Sample_02.depth.tsv")
                ]
                input[1] = "40"
                """
            }
        }

        then {

            def outFile = process.out.coverage_tsv[0]

            if (outFile.toString().contains("/dev-wslh") || outFile.toString().contains("/prod-wslh")) {

                def combined = "s3:/" + outFile.toString()
                def localFile = downloadFromS3(combined)

                assertAll(

                    { assert localFile.text.contains("Average coverage < 40X")              },
                    { assert localFile.text.contains("SPN_Sample_01")                       },
                    { assert localFile.text.contains("SPN_Sample_02")                       },
                    { assert localFile.toString().endsWith(".tsv")                          },
                    { assert localFile.toString().split('/')[-1] ==~ "coverage_stats.tsv"   }
                )
            } else {
                assertAll(
                    { assert file(outFile).text.contains("Average coverage < 40X")  },
                    { assert file(outFile).text.contains("SPN_Sample_01")           },
                    { assert file(outFile).text.contains("SPN_Sample_02")           },
                    { assert file(outFile).name.endsWith(".tsv")                    },
                    { assert file(outFile).name ==~ "coverage_stats.tsv"            },
                    { assert snapshot(path(outFile).md5).match()                    }
                )
            }
        }
    }

    test("Checking that missing input process fails.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                input[1] = "40"
                """
            }
        }

        then {
            assert !process.success
        }
    }


    test("Checking that missing min coverage fails.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${projectDir}/modules/local/coverage_stats/tests"
                """
                input[0] = [
                file("${data_dir}" + "/data1/SPN_Sample_01.depth.tsv"),
                file("${data_dir}" + "/data2/SPN_Sample_02.depth.tsv")
                ]
                input[1] = null
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
