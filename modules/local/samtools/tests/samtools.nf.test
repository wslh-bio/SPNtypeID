nextflow_process {

    name "Test Process SAMTOOLS"
    script "modules/local/samtools/samtools.nf"
    process "SAMTOOLS"
    tag "module"

    test("Checking that output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'SAMPLE1_PE', single_end:false ],
                [ file("${baseDir}" + '/modules/local/samtools/tests/data/SAMPLE1_PE.sam') ]
                ]
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert process.out.cov_files.size() == 1 },
                { assert process.out.stats_multiqc.size() == 1 },
                { assert process.out.sorted_bam.size() == 1 },
                { assert process.out.versions.size() == 1 }
            )
        }
    }

    test("Checking file contents to ensure proper processing.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'SAMPLE1_PE', single_end:false ],
                [ file("${baseDir}" + '/modules/local/samtools/tests/data/SAMPLE1_PE.sam') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert snapshot(
                    path(process.out.sorted_bam[0]).md5,
                    path(process.out.cov_files[0]).md5,
                    path(process.out.stats_multiqc[0]).md5,
                    path(process.out.versions[0]).md5
                    ).match()
                },
                { assert file(process.out.sorted_bam[0]).name.endsWith("bam") },
                { assert file(process.out.cov_files[0]).name.endsWith("depth.tsv") },
                { assert file(process.out.stats_multiqc[0]).name.endsWith("stats.txt") },
                { assert file(process.out.versions[0]).name.endsWith("yml") }
            )
        }
    }

    test("Checking that no input files channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
