nextflow_process {

    name "Test Process REJECTED_SAMPLES"
    script "modules/local/rejected_samples/rejected_samples.nf"
    process "REJECTED_SAMPLES"
    tag "module"

    test("Checking that output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/rejected_samples/tests/data"
                """
                input[0] = file("${data_dir}" + "/empty_samples.csv")
                input[1] = "SPNTypeID"
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                    },
                { assert process.exitStatus == 0                            },
                { assert process.out.rejected_samples_report.size() == 1    }
            )
        }
    }

   test("Checking file contents to ensure proper processing") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/rejected_samples/tests/data"
                """
                input[0] = file("${data_dir}" + "/empty_samples.csv")
                input[1] = "SPNTypeID"
                """
            }
        }

        then {
            def outFile = process.out.rejected_samples_report[0]

            if (outFile.toString().contains("/dev-wslh") || outFile.toString().contains("/prod-wslh")) {

                def combined = "s3:/" + outFile.toString()
                def localFile = downloadFromS3(combined)

                assertAll(
                    { assert localFile.toString().split("/")[-1] ==~ "SPNTypeID_empty_samples.csv"      },
                    { assert localFile.text.contains("NO_EMPTY_SAMPLES")                                }
                )
            } else {
                assertAll(
                    { assert snapshot(path(outFile).md5).match()                                        },
                    { assert file(outFile).text.contains("NO_EMPTY_SAMPLES")                            },
                    { assert file(outFile).name ==~ "SPNTypeID_empty_samples.csv"                       }
                )
            }
        }
    }

   test("Checking that no input files channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/rejected_samples/tests/data"
                """
                input[0] = null
                input[1] = "SPNTypeID"
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
