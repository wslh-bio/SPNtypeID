nextflow_process {

    name "Test Process PERCENT_STREP_SUMMARY"
    script "modules/local/percent_strep_summary/percent_strep_summary.nf"
    process "PERCENT_STREP_SUMMARY"
    tag "module"

    test("Checks to see output channels have proper amounts of files") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/kraken_summary/tests/data"
                """
                input[0] = [
                file("${data_dir}" + "/SPN_Sample_01.kraken2.txt"),
                file("${data_dir}" + "/SPN_Sample_02.kraken2.txt"),
                file("${data_dir}" + "/SPN_Sample_03.kraken2.txt")
                ]
                input[1] ="80.0"
                input[2] ="60.0"
                input[3] ="1.0"
                """
            }
        }

        then {
            assertAll(
                { assert process.success                            },
                { assert process.exitStatus == 0                    },
                { assert process.out.percent_strep_tsv.size() == 1  }
            )
        }
    }

    test("Checks that name of file is correct and has proper content") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/kraken_summary/tests/data"
                """
                input[0] = [
                file("${data_dir}" + "/SPN_Sample_01.kraken2.txt"),
                file("${data_dir}" + "/SPN_Sample_02.kraken2.txt"),
                file("${data_dir}" + "/SPN_Sample_03.kraken2.txt")
                ]
                input[1] ="80.0"
                input[2] ="60.0"
                input[3] ="1.0"
                """
            }
        }

        then {
            assertAll(
                { assert snapshot(path(process.out.percent_strep_tsv[0]).md5).match()                   },
                { assert file(process.out.percent_strep_tsv[0]).name.endsWith("tsv")                    },
                { assert file(process.out.percent_strep_tsv[0]).name ==~ "percent_strep_results.tsv"    }
            )
        }
    }

    test("Checking that no input files channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/kraken_summary/tests/data"
                """
                input[0] = null
                input[1] ="80.0"
                input[2] ="60.0"
                input[3] ="1.0"
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
