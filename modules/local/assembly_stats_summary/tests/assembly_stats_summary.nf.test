nextflow_process {

    name "Test Process ASSEMBLY_STATS_SUMMARY"
    script "modules/local/assembly_stats_summary/assembly_stats_summary.nf"
    process "ASSEMBLY_STATS_SUMMARY"
    tag "module"

    test("Checking that output channel has appropriate contents and contains proper samples.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/assembly_stats_summary/tests/data/"
                """
                input[0] = [
                file("${data_dir}" + "SPN_Sample_01_Assembly_ratio_20240124.tsv"),
                file("${data_dir}" + "SPN_Sample_02_Assembly_ratio_20240124.tsv"),
                file("${data_dir}" + "SPN_Sample_03_Assembly_ratio_20240124.tsv")
                ]
                """
            }
        }

        then {

            if ( System.getenv("NFT_PROFILE")?.contains("aws") ) {

                def combined = "s3:/" + outFile.toString()
                def localFile = downloadFromS3(combined)

                assertAll(
                    { assert localFile.text.contains("SPN_Sample_01") },
                    { assert localFile.text.contains("SPN_Sample_02") },
                    { assert localFile.text.contains("SPN_Sample_03") },
                    { assert localFile.toString().endsWith(".tsv") },
                    { assert localFile.toString().split('/')[-1] ==~ "assembly_stats_results_summary.tsv" }
                )
            } else {

                def outFile = process.out.assembly_stats_tsv[0]

                assertAll(
                    { assert file(outFile).text.contains("SPN_Sample_01") },
                    { assert file(outFile).text.contains("SPN_Sample_02") },
                    { assert file(outFile).text.contains("SPN_Sample_03") },
                    { assert file(outFile).name.endsWith(".tsv") },
                    { assert file(outFile).name ==~ "assembly_stats_results_summary.tsv" },
                    { assert snapshot(path(outFile).md5).match() }
                )
            }
        }
    }

    test("Checking that output channel has appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = file("${baseDir}" + "/modules/local/assembly_stats_summary/tests/data/*")
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert process.exitStatus == 0 },
                { assert process.out.assembly_stats_tsv.size() == 1 }
            )
        }
    }

    test("Checking that no input channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                """
            }
        }

        then {
            { assert !process.success }
        }
    }
}
