nextflow_process {

    name "Test Process BIOAWK"
    script "modules/local/bioawk/bioawk.nf"
    process "BIOAWK"
    tag "module"

    test("Checking that output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert process.exitStatus == 0 },
                { assert process.out.qual_results.size()==1 },
                { assert process.success },
                { assert process.out.qual_results.size()==1 },
                { assert process.out.versions.size()==1 }
            )
        }
    }

    test("Checking file contents to ensure proper processing.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            if (process.out.qual_results[0].toString().contains("/dev-wslh") || process.out.qual_results[0].toString().contains("/prod-wslh")) {

                def outFile = process.out.qual_results[0]
                def combined = "s3:/" + outFile.toString()
                def localFile = downloadFromS3(combined)

                assertAll(
                    { assert snapshot(localFile.md5).match() },
                    { assert localFile.toString().endsWith("tsv") },
                    { assert localFile.toString().split('/')[-1] ==~"test.qual.tsv" }
                )

            } else {
                assertAll(

                    { assert snapshot(path(process.out.qual_results[0]).md5).match() },
                    { assert file(process.out.qual_results[0]).name.endsWith("tsv") },
                    { assert file(process.out.qual_results[0]).name ==~ "test.qual.tsv" }
                )
            }
        }
    }

    test("Checking that no input channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                """
            }
        }

        then {
            { assert !process.success }
        }
    }
}
