nextflow_process {

    name "Test Process BIOAWK"
    script "modules/local/bioawk/bioawk.nf"
    process "BIOAWK"
    tag "module"

    test("Checking that output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert process.exitStatus == 0 },
                { assert process.out.qual_results.size()==1 },
                { assert process.success },
                { assert process.out.qual_results.size()==1 },
                { assert process.out.versions.size()==1 }
            )
        }
    }

    test("Checking file contents to ensure proper processing.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(

                { assert snapshot(process.out).match() },
                { assert file(process.out.qual_results[0]).name.endsWith("tsv") },
                { assert file(process.out.qual_results[0]).name ==~ "test.qual.tsv" }
            )
        }
    }

    test("Checking that no input channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                """
            }
        }

        then {
            { assert !process.success }
        }
    }
}
