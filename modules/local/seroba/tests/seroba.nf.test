nextflow_process {

    name "Test Process SEROBA"
    script "modules/local/seroba/seroba.nf"
    process "SEROBA"
    tag "module"

    test("Checking that mandatory output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.seroba_results.size() == 1 },
                { assert process.out.log.size() == 1 },
                { assert process.out.versions.size() == 1}
            )
        }
    }

    test("Checking that optional output channel has appropriate amount of values given a certain sample") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assert process.out.seroba_detailed_results.size() == 0
        }
    }

    test("Checking mandatory output files have appropriate content") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert snapshot(path(process.out.seroba_results[0]).md5).match() },
                { assert file(process.out.seroba_results[0]).name.endsWith("csv") },
                { assert file(process.out.log[0]).name.endsWith("log") },
                { assert file(process.out.versions[0]).name.endsWith("yml") }
            )

        }
    }

    test("Checking that no input files channel produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = null
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
