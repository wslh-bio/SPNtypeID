nextflow_process {

    name "Test Process FASTQC_SUMMARY"
    script "modules/local/fastqc_summary/fastqc_summary.nf"
    process "FASTQC_SUMMARY"
    tag "module"

    test("Checking that output channels have appropriate amount of values.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/fastqc_summary/tests/data"
                """
                input[0] = [
                file("${data_dir}" + "/SPN_Sample_01_1_fastqc.zip"),
                file("${data_dir}" + "/SPN_Sample_01_2_fastqc.zip"),
                file("${data_dir}" + "/SPN_Sample_02_1_fastqc.zip"),
                file("${data_dir}" + "/SPN_Sample_02_2_fastqc.zip")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.exitStatus == 0 },
                { assert process.out.fastqc_summary.size() == 1  }

            )
        }
    }

    test("Checking that output channels have appropriate contents.") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/fastqc_summary/tests/data"
                """
                input[0] = [
                file("${data_dir}" + "/SPN_Sample_01_1_fastqc.zip"),
                file("${data_dir}" + "/SPN_Sample_01_2_fastqc.zip"),
                file("${data_dir}" + "/SPN_Sample_02_1_fastqc.zip"),
                file("${data_dir}" + "/SPN_Sample_02_2_fastqc.zip")
                ]
                """
            }
        }

        then {

            def outFile = process.out.fastqc_summary[0]

            if (outFile.toString().contains("/dev-wslh") || outFile.toString().contains("/prod-wslh")) {

                def combined = "s3:/" + outFile.toString()
                def localFile = downloadFromS3(combined)

                assertAll(
                    { assert localFile.text.contains("Per base sequence quality")           },
                    { assert localFile.text.contains("Per tile sequence quality")           },
                    { assert localFile.text.contains("PASS")                                },
                    { assert localFile.toString().endsWith(".tsv")                          },
                    { assert localFile.toString().split('/')[-1] ==~ "fastqc_summary.tsv"   }
                )
            } else {
                assertAll(
                    { assert file(outFile).text.contains("Per base sequence quality")           },
                    { assert file(outFile).text.contains("Per tile sequence quality")           },
                    { assert file(outFile).text.contains("PASS")                                },
                    { assert file(outFile).name.endsWith(".tsv")                                },
                    { assert file(outFile).name ==~ "fastqc_summary.tsv"                        }
                )
            }
        }
    }

    test("Checking no input channels produces failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/fastqc_summary/tests/data"
                """
                input[0] = null
                ]
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
