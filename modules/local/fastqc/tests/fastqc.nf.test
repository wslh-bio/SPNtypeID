nextflow_process {

    name "Test Process FASTQC"
    script "modules/local/fastqc/fastqc.nf"
    process "FASTQC"
    tag "module"

    test("Checking that output channels have appropriate amount of values") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.exitStatus == 0 },
                { assert process.out.html[0][1].size() == 2 },
                { assert process.out.zip[0][1].size() == 2 },
                { assert process.out.versions.size() == 1 }
            )
        }
    }

    test("Checking outputs names") {

        when {
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert file(process.out.zip[0][1][0]).name.endsWith("zip") },
                { assert file(process.out.zip[0][1][1]).name.endsWith("zip") },
                {
                    with(process.out.zip) {
                        with (get(0)) {
                            with (get(1)) {
                                assert get(0) ==~ ".*/test_1_fastqc.zip"
                                assert get(1) ==~ ".*/test_2_fastqc.zip"
                            }
                        }
                    }
                },
                { assert file(process.out.html[0][1][0]).name.endsWith("html") },
                { assert file(process.out.html[0][1][1]).name.endsWith("html") },
                {
                    with(process.out.html) {
                        with (get(0)) {
                            with (get(1)) {
                                assert get(0) ==~ ".*/test_1_fastqc.html"
                                assert get(1) ==~ ".*/test_2_fastqc.html"
                            }
                        }
                    }
                }
            )
        }
    }

    test('Checking snapshot contents') {

        when {
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert snapshot(path(process.out.versions[0]).md5).match() }
            )
        }
    }

    test('Checking that no input channel produces failure') {

        when {
            process {
                """
                input[0] = null
                """
            }
        }

        then {
            assert !process.success
        }
    }
}
